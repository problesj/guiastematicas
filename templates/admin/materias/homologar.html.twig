{% extends 'panel/_layout.html.twig' %}

{% block title %}{{ 'materia.homologar_titulo'|trans({'%materia%': materia.nombre}) }}{% endblock %}

{% block contenido %}
    <h1>{{ 'materia.homologar_titulo'|trans({'%materia%': materia.nombre}) }}</h1>
    <p>{{ 'materia.homologar_explicacion'|trans }}</p>

    <h2>{{ 'materia.homologar_afectados'|trans }}</h2>
    <ul class="homologar__cuentas">
        {% for clave, n in cuentas %}
            <li>{{ ('materia.homologar_' ~ clave)|trans({'%count%': n}) }}</li>
        {% endfor %}
    </ul>

    {% if error %}<p class="aviso aviso--error" role="alert">{{ error|trans }}</p>{% endif %}

    <form method="post" class="formulario formulario--angosto"
          data-controller="confirmar" data-action="submit->confirmar#preguntar"
          data-confirmar-mensaje-value="{{ 'materia.homologar_confirmar'|trans({'%materia%': materia.nombre}) }}">
        <input type="hidden" name="_token" value="{{ csrf_token('homologar-materia-' ~ materia.id) }}">
        <div class="campo">
            <label for="categoria">{{ 'materia.homologar_categoria'|trans }}</label>
            <select id="categoria" name="categoria" required>
                <option value="">{{ 'materia.homologar_elige_opcion'|trans }}</option>
                {{ include('_opciones_materias.html.twig', {materias: categorias, elegida: elegida, valor: 'id'}) }}
            </select>
            {% if materia.asjc is not empty %}
                <p class="campo__ayuda">{{ 'materia.homologar_clasificada'|trans({'%categorias%': materia.asjc|map(c => c ~ ' · ' ~ asjc_nombre(c))|join(', ')}) }}</p>
            {% endif %}
        </div>
        <div class="formulario__acciones">
            <button type="submit" class="boton">{{ icono('homologar') }}{{ 'materia.homologar'|trans }}</button>
            <a class="boton boton--secundario" href="{{ path('admin_materias') }}">{{ icono('cancelar') }}{{ 'formulario.cancelar'|trans }}</a>
        </div>
    </form>
{% endblock %}
