{# Botón de eliminar con confirmación. Parámetros: ruta, id, token, nombre y, opcionales, extra_ruta (más parámetros de la ruta). #}
<form method="post" action="{{ path(ruta, {id: id}|merge(extra_ruta ?? {})) }}" class="en-linea"
      data-controller="confirmar" data-action="submit->confirmar#preguntar"
      data-confirmar-mensaje-value="{{ 'formulario.confirmar_eliminar'|trans({'%nombre%': nombre}) }}">
    <input type="hidden" name="_token" value="{{ csrf_token(token) }}">
    <button type="submit" class="accion accion--peligro" data-tooltip="{{ 'formulario.eliminar'|trans }}">{{ icono('eliminar') }}<span class="solo-lectores">{{ 'formulario.eliminar'|trans }} {{ nombre }}</span></button>
</form>
