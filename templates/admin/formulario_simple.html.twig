{% extends 'panel/_layout.html.twig' %}

{% block title %}{{ titulo|trans }}{% endblock %}

{% block contenido %}
    <h1>{{ titulo|trans }}</h1>
    {{ form_start(formulario, {attr: {class: 'formulario formulario--angosto', novalidate: 'novalidate'}}) }}
        {{ form_rest(formulario) }}
        <div class="formulario__acciones">
            <button type="submit" class="boton">{{ 'formulario.guardar'|trans }}</button>
            <a href="{{ path(volver) }}">{{ 'formulario.cancelar'|trans }}</a>
        </div>
    {{ form_end(formulario) }}
{% endblock %}
