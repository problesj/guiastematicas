{% extends 'panel/_layout.html.twig' %}

{% block title %}{{ 'configuracion.titulo'|trans }}{% endblock %}

{% block contenido %}
    <h1>{{ 'configuracion.titulo'|trans }}</h1>
    <p class="pagina__bajada">{{ 'configuracion.bajada'|trans }}</p>

    {{ form_start(formulario, {attr: {class: 'formulario formulario--configuracion', novalidate: 'novalidate'}}) }}
        {% for grupo, claves in grupos %}
            <fieldset class="configuracion__grupo">
                <legend>{{ ('configuracion.grupo.' ~ grupo)|trans }}</legend>
                <p class="campo__ayuda">{{ ('configuracion.grupo_ayuda.' ~ grupo)|trans }}</p>
                {% for clave in claves %}
                    {% set e = estado[clave] %}
                    <div class="configuracion__ajuste">
                        {{ form_row(attribute(formulario, clave)) }}
                        <p class="configuracion__estado">
                            <code>{{ clave }}</code> ·
                            {% if e.ilegible %}
                                <strong class="configuracion__alerta">{{ 'configuracion.estado.ilegible'|trans }}</strong>
                            {% elseif e.secreto and e.panel %}
                                {{ 'configuracion.estado.clave_panel'|trans }}
                            {% elseif e.panel %}
                                {{ 'configuracion.estado.panel'|trans }}
                            {% elseif e.servidor is not empty %}
                                {{ e.secreto ? 'configuracion.estado.clave_servidor'|trans : 'configuracion.estado.servidor'|trans({'%valor%': e.servidor}) }}
                            {% else %}
                                {{ 'configuracion.estado.sin_definir'|trans }}
                            {% endif %}
                        </p>
                        {% if e.secreto %}
                            {% if e.panel %}{{ form_row(attribute(formulario, clave ~ '__borrar')) }}{% else %}{% do attribute(formulario, clave ~ '__borrar').setRendered %}{% endif %}
                        {% endif %}
                    </div>
                {% endfor %}
            </fieldset>
        {% endfor %}
        <div class="formulario__acciones">
            <button type="submit" class="boton">{{ 'formulario.guardar'|trans }}</button>
        </div>
    {{ form_end(formulario) }}

    <section class="configuracion__grupo integracion" aria-labelledby="titulo-wordpress">
        <h2 id="titulo-wordpress">{{ 'configuracion.wordpress.titulo'|trans }}</h2>
        <p>{{ 'configuracion.wordpress.bajada'|trans }}</p>
        <p><a class="boton boton--secundario" href="{{ path('admin_configuracion_wordpress') }}" download>{{ 'configuracion.wordpress.descargar'|trans }}</a></p>
        <ol>
            <li>{{ 'configuracion.wordpress.paso1'|trans }}</li>
            <li>{{ 'configuracion.wordpress.paso2'|trans }}</li>
            <li>{{ 'configuracion.wordpress.paso3'|trans }}</li>
        </ol>
        <ul class="integracion__codigos">
            <li><code>[guias_ucn materia="medicina" vista="cuadricula"]</code> {{ 'configuracion.wordpress.codigo_lista'|trans }}</li>
            <li><code>[guia_ucn slug="ingenieria"]</code> {{ 'configuracion.wordpress.codigo_guia'|trans }}</li>
            <li><code>[guia_ucn_bloque id="12"]</code> {{ 'configuracion.wordpress.codigo_bloque'|trans }}</li>
            <li><code>[recursos_ucn materia="medicina" limite="10"]</code> {{ 'configuracion.wordpress.codigo_recursos'|trans }}</li>
        </ul>
    </section>
{% endblock %}
