{# Icono representativo del tipo de recurso, para la vista en cuadrícula (decorativo: el tipo ya se nombra en la página). #}
<span class="recurso__icono recurso__icono--{{ tipo }}" aria-hidden="true">
    <svg viewBox="0 0 48 48" width="40" height="40" focusable="false" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        {%- if tipo == 'base_datos' -%}
            <ellipse cx="24" cy="11" rx="14" ry="5"/><path d="M10 11v26c0 2.8 6.3 5 14 5s14-2.2 14-5V11"/><path d="M10 20c0 2.8 6.3 5 14 5s14-2.2 14-5M10 29c0 2.8 6.3 5 14 5s14-2.2 14-5"/>
        {%- elseif tipo == 'libros' -%}
            <path d="M24 13c-4-3-10-4-16-3v27c6-1 12 0 16 3 4-3 10-4 16-3V10c-6-1-12 0-16 3z"/><path d="M24 13v27"/>
        {%- elseif tipo == 'revistas' -%}
            <rect x="11" y="6" width="26" height="36" rx="2"/><path d="M17 14h14M17 20h14M17 26h8"/><rect x="17" y="31" width="14" height="6" rx="1"/>
        {%- else -%}
            <path d="M14 6h14l8 8v28H14z"/><path d="M28 6v8h8M19 24h12M19 30h12"/>
        {%- endif -%}
    </svg>
</span>
