{# Formato de un libro o revista: icono (decorativo) y texto. Parámetro: formato (electronico | impreso | ambos). #}
{% set iconos = {
    impreso: '<path d="M12 6.5C10 5 7 4.5 3 5v13c4-.5 7 0 9 1.5 2-1.5 5-2 9-1.5V5c-4-.5-7 0-9 1.5z"/><path d="M12 6.5v13"/>',
    electronico: '<rect x="3" y="4" width="18" height="12" rx="1.5"/><path d="M8 20h8M12 16v4"/>',
} %}
<span class="formato formato--{{ formato }}">
    {%- for icono in (formato == 'ambos' ? ['impreso', 'electronico'] : [formato]) -%}
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">{{ iconos[icono]|raw }}</svg>
    {%- endfor -%}
    {{ ('formato_recurso.' ~ formato)|trans }}
</span>
