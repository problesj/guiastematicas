{% extends 'base.html.twig' %}

{% block body %}
    <div class="contenedor panel {% block clase_panel %}{% endblock %}">
        <nav class="panel__menu" aria-label="{{ 'panel.menu'|trans }}">
            {% set ruta = app.request.attributes.get('_route') %}
            <p class="panel__usuario">
                <strong>{{ app.user.nombreCompleto }}</strong>
                <span>{{ app.user.rol.etiqueta|trans }}</span>
            </p>
            <ul>
                <li><a href="{{ path('panel') }}" {% if ruta == 'panel' %}aria-current="page"{% endif %}>{{ 'panel.inicio'|trans }}</a></li>
                <li><a href="{{ path('panel_perfil') }}" {% if ruta == 'panel_perfil' %}aria-current="page"{% endif %}>{{ 'panel.perfil'|trans }}</a></li>
                {% if app.user.tieneContrasenaPropia %}
                    <li><a href="{{ path('panel_contrasena') }}" {% if ruta == 'panel_contrasena' %}aria-current="page"{% endif %}>{{ 'panel.contrasena'|trans }}</a></li>
                {% endif %}
            </ul>
            <p class="panel__grupo">{{ 'panel.contenido'|trans }}</p>
            <ul>
                <li><a href="{{ path('panel_guias') }}" {% if ruta starts with 'panel_guia' %}aria-current="page"{% endif %}>{{ 'panel.guias'|trans }}</a></li>
                {% if is_granted('ROLE_EDITOR') %}
                    <li><a href="{{ path('panel_recursos') }}" {% if ruta starts with 'panel_recurso' %}aria-current="page"{% endif %}>{{ 'panel.recursos'|trans }}</a></li>
                    <li><a href="{{ path('panel_autores') }}" {% if ruta starts with 'panel_autor' %}aria-current="page"{% endif %}>{{ 'panel.autores'|trans }}</a></li>
                    <li><a href="{{ path('panel_editoriales') }}" {% if ruta starts with 'panel_editorial' %}aria-current="page"{% endif %}>{{ 'panel.editoriales'|trans }}</a></li>
                {% endif %}
            </ul>
            {% if is_granted('ROLE_ADMINISTRADOR') %}
                <p class="panel__grupo">{{ 'panel.administracion'|trans }}</p>
                <ul>
                    <li><a href="{{ path('admin_usuarios') }}" {% if ruta starts with 'admin_usuario' %}aria-current="page"{% endif %}>{{ 'panel.usuarios'|trans }}</a></li>
                    <li><a href="{{ path('admin_departamentos') }}" {% if ruta starts with 'admin_departamento' %}aria-current="page"{% endif %}>{{ 'panel.departamentos'|trans }}</a></li>
                    <li><a href="{{ path('admin_materias') }}" {% if ruta starts with 'admin_materia' %}aria-current="page"{% endif %}>{{ 'panel.materias'|trans }}</a></li>
                    <li><a href="{{ path('admin_paises') }}" {% if ruta starts with 'admin_pais' %}aria-current="page"{% endif %}>{{ 'panel.paises'|trans }}</a></li>
                    <li><a href="{{ path('admin_configuracion') }}" {% if ruta == 'admin_configuracion' %}aria-current="page"{% endif %}>{{ 'panel.configuracion'|trans }}</a></li>
                </ul>
            {% endif %}
        </nav>
        <div class="panel__contenido">
            {% block contenido %}{% endblock %}
        </div>
    </div>
{% endblock %}
