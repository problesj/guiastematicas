{# Materias que se asignan de una vez a todos los libros o revistas que se agregan desde el buscador (ver
   buscador-libros / buscador-revistas). Sin elegir ninguna, cada uno nuevo queda con las materias de la guía. #}
<details class="materias-masivas">
    <summary>{{ 'bloque.materias_masivas'|trans }} <span data-{{ controlador }}-target="cuentaMaterias"></span></summary>
    <p class="campo__ayuda">{{ 'bloque.materias_masivas_ayuda'|trans }}</p>
    {{ include('_selector_materias.html.twig', {
        id: controlador ~ '-materias-masivas',
        nombre: '',
        marcadas: [],
        etiqueta: 'bloque.materias_masivas'|trans,
        casilla: {('data-' ~ controlador ~ '-target'): 'materia', 'data-action': controlador ~ '#contarMaterias'},
    }) }}
</details>
