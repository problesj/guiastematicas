{% extends 'panel/_layout.html.twig' %}

{% block title %}{{ 'panel.guias'|trans }}{% endblock %}

{% block contenido %}
    <div class="encabezado-accion">
        <h1>{{ 'panel.guias'|trans }}</h1>
        {% if is_granted('ROLE_EDITOR') %}<div class="encabezado-accion__botones"><a class="boton boton--secundario" href="{{ path('panel_guia_nueva') }}">{{ 'guia.nueva_manual'|trans }}</a><a class="boton" href="{{ path('panel_guia_asistente') }}">{{ 'asistente.boton'|trans }}</a></div>{% endif %}
    </div>

    <form method="get" class="filtro" role="search">
        <label for="q" class="solo-lectores">{{ 'guias.buscar'|trans }}</label>
        <input type="search" id="q" name="q" value="{{ q }}" placeholder="{{ 'guias.buscar_placeholder'|trans }}" class="filtro__texto">
        <label for="filtro-estado" class="solo-lectores">{{ 'guia.estado'|trans }}</label>
        <select id="filtro-estado" name="estado">
            <option value="">{{ 'guia.todos_estados'|trans }}</option>
            {% for e in estados %}<option value="{{ e.value }}" {% if estado == e %}selected{% endif %}>{{ e.etiqueta|trans }}</option>{% endfor %}
        </select>
        {% if materias is not empty %}
            <label for="filtro-materia" class="solo-lectores">{{ 'bases.materia'|trans }}</label>
            <select id="filtro-materia" name="materia">
                <option value="">{{ 'bases.todas_materias'|trans }}</option>
                {{ include('_opciones_materias.html.twig', {materias: materias, elegida: materia}) }}
            </select>
        {% endif %}
        {% if responsables|length > 1 %}
            <label for="filtro-responsable" class="solo-lectores">{{ 'guia.responsable'|trans }}</label>
            <select id="filtro-responsable" name="responsable">
                <option value="">{{ 'guia.todos_responsables'|trans }}</option>
                {% for r in responsables %}<option value="{{ r.id }}" {% if responsable and responsable.id == r.id %}selected{% endif %}>{{ r.nombreCompleto }}</option>{% endfor %}
            </select>
        {% endif %}
        <label for="filtro-idioma" class="solo-lectores">{{ 'guia.idioma'|trans }}</label>
        <select id="filtro-idioma" name="idioma">
            <option value="">{{ 'guia.todos_idiomas'|trans }}</option>
            {% for i in ['es', 'en'] %}<option value="{{ i }}" {% if idioma == i %}selected{% endif %}>{{ ('idioma.' ~ i)|trans }}</option>{% endfor %}
        </select>
        <button type="submit" class="boton boton--secundario">{{ 'guias.buscar'|trans }}</button>
    </form>
    {{ include('panel/_filtros_recordados.html.twig', {ruta: 'panel_guias'}) }}

    {% if guias is empty %}
        <p>{{ total_editables > 0 ? 'guia.sin_resultados_filtros'|trans : (is_granted('ROLE_EDITOR') ? 'guia.vacio_editor' : 'guia.vacio_colaborador')|trans }}</p>
    {% else %}
        <p>{{ 'guias.resultados'|trans({'%count%': guias|length}) }}</p>
        <div class="tabla-desplazable">
            <table class="tabla tabla--guias">
                <thead>
                    <tr>
                        <th scope="col" class="tabla-guias__columna-titulo">{{ 'guia.titulo'|trans }}</th>
                        <th scope="col">{{ 'guia.estado'|trans }}</th>
                        <th scope="col">{{ 'guia.responsable'|trans }}</th>
                        <th scope="col">{{ 'guia.actualizada'|trans }}</th>
                        <th scope="col">{{ 'guia.visitas'|trans }}</th>
                        <th scope="col"><span class="solo-lectores">{{ 'formulario.acciones'|trans }}</span></th>
                    </tr>
                </thead>
                <tbody>
                    {% for guia in guias %}
                        <tr>
                            <td>
                                <div class="tabla-guias__guia">
                                    {% if guia.icono %}<img class="tabla-guias__icono" src="{{ asset('uploads/guias/' ~ guia.icono) }}" alt="" width="44" height="44">{% else %}<span class="tabla-guias__icono tabla-guias__icono--vacio" aria-hidden="true">{{ guia.titulo|first|upper }}</span>{% endif %}
                                    <div>
                                        <a class="tabla-guias__titulo" href="{{ path('panel_guia_editar', {id: guia.id}) }}">{{ guia.titulo }}</a>
                                        <small class="tabla-guias__meta"><abbr title="{{ ('idioma.' ~ guia.idioma)|trans }}">{{ guia.idioma|upper }}</abbr>{% if guia.principal %} · {{ 'guia.parte_de'|trans }}: {{ guia.principal.titulo }}{% endif %}</small>
                                    </div>
                                </div>
                            </td>
                            <td class="tabla-guias__estado"><span class="etiqueta etiqueta--{{ guia.estado.value }}">{{ guia.estado.etiqueta|trans }}</span>{% if guia.restringida %} <span class="insignia insignia--restringida"><span aria-hidden="true">🔒</span> {{ 'guia.restringida'|trans }}</span>{% endif %}</td>
                            <td>{{ guia.responsable ? guia.responsable.nombreCompleto : '—' }}</td>
                            <td class="tabla-guias__fecha">{{ guia.actualizadaEn|date('d-m-Y') }}<br><small>{{ guia.actualizadaEn|date('H:i') }}</small></td>
                            <td>{{ guia.visitas }}</td>
                            <td class="tabla__acciones">
                                <a class="accion" data-tooltip="{{ 'formulario.editar'|trans }}" href="{{ path('panel_guia_editar', {id: guia.id}) }}">{{ icono('editar') }}<span class="solo-lectores">{{ 'formulario.editar'|trans }} {{ guia.titulo }}</span></a>
                                {% if guia.publicada %}<a class="accion" data-tooltip="{{ 'guia.ver_publicada'|trans }}" href="{{ path('guia', {slug: guia.slug, _locale: guia.idioma}) }}" target="_blank" rel="noopener">{{ icono('ver') }}<span class="solo-lectores">{{ 'guia.ver_publicada'|trans }} {{ guia.titulo }} ({{ 'bases.ventana_nueva'|trans }})</span></a>{% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
{% endblock %}
