{% extends 'panel/_layout.html.twig' %}

{% block title %}{{ titulo|trans }}{% endblock %}

{% block contenido %}
    <h1>{{ titulo|trans }}</h1>
    {{ form_start(formulario, {attr: {class: 'formulario', novalidate: 'novalidate'}}) }}
        <fieldset>
            <legend>{{ 'recurso.grupo_datos'|trans }}</legend>
            {{ form_row(formulario.titulo) }}
            {{ form_row(formulario.nombresAlternativos) }}
            {{ form_row(formulario.url) }}
            {{ form_row(formulario.requiereProxy) }}
            <div class="formulario__columnas">
                {{ form_row(formulario.tipo) }}
                {{ form_row(formulario.acceso) }}
                {{ form_row(formulario.pruebaHasta) }}
                {{ form_row(formulario.proveedor) }}
            </div>
            {{ form_row(formulario.descripcion) }}
            {{ form_row(formulario.descripcionEn) }}
        </fieldset>
        <fieldset data-controller="campos-tipo" data-campos-tipo-selector-value="#{{ formulario.tipo.vars.id }}">
            <legend>{{ 'recurso.grupo_bibliograficos'|trans }}</legend>
            <p class="campo__ayuda" data-campos-tipo-target="vacio" hidden>{{ 'recurso.sin_bibliograficos'|trans }}</p>
            <div class="formulario__columnas">
                {% for campo in campos_bibliograficos %}
                    {% if campo == 'autores' %}
                        <div class="campo--completo" data-campos-tipo-target="campo" data-tipos="{{ tipos_por_campo[campo]|join(' ') }}">{% include 'panel/recursos/_selector_autores.html.twig' %}</div>
                    {% else %}
                        <div data-campos-tipo-target="campo" data-tipos="{{ tipos_por_campo[campo]|join(' ') }}">{{ form_row(formulario[campo]) }}</div>
                    {% endif %}
                {% endfor %}
            </div>
            <datalist id="editoriales-existentes">
                {% for nombre in editoriales %}<option value="{{ nombre }}"></option>{% endfor %}
            </datalist>
        </fieldset>
        <fieldset>
            <legend>{{ 'recurso.materias'|trans }}</legend>
            {{ form_row(formulario.materias, {label: false}) }}
        </fieldset>
        {{ form_row(formulario.visible) }}
        <div class="formulario__acciones">
            <button type="submit" class="boton">{{ 'formulario.guardar'|trans }}</button>
            <a href="{{ path('panel_recursos') }}">{{ 'formulario.cancelar'|trans }}</a>
        </div>
    {{ form_end(formulario) }}
{% endblock %}
