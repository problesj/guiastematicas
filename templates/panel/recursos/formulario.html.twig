{% extends 'panel/_layout.html.twig' %}

{% block title %}{{ titulo|trans }}{% endblock %}

{% block contenido %}
    <h1>{{ titulo|trans }}</h1>
    {{ form_start(formulario, {attr: {class: 'formulario', novalidate: 'novalidate'}}) }}
        {% include 'panel/recursos/_campos.html.twig' %}
        <div class="formulario__acciones">
            <button type="submit" class="boton">{{ 'formulario.guardar'|trans }}</button>
            <a class="boton boton--secundario" href="{{ path('panel_recursos') }}" data-tooltip="{{ 'formulario.cancelar_ayuda'|trans }}">{{ icono('cancelar') }}{{ 'formulario.cancelar'|trans }}</a>
        </div>
    {{ form_end(formulario) }}
{% endblock %}
