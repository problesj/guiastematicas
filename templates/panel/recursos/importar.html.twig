{% extends 'panel/_layout.html.twig' %}

{% block title %}{{ 'importacion.titulo'|trans }}{% endblock %}

{% block contenido %}
    <h1>{{ 'importacion.titulo'|trans }}</h1>
    <p>{{ 'importacion.bajada'|trans }}</p>

    {% if error is defined and error %}
        <p class="aviso aviso--error" role="alert">{{ error|trans }}</p>
    {% endif %}

    <form method="post" enctype="multipart/form-data" class="formulario formulario--angosto" data-turbo="false">
        <div class="campo">
            <label for="archivo">{{ 'importacion.archivo'|trans }}</label>
            <input type="file" id="archivo" name="archivo" accept=".xlsx,.xls,.ods,.csv,.bib,.bibtex,.ris" required aria-describedby="archivo_ayuda">
            <p id="archivo_ayuda" class="campo__ayuda">{{ 'importacion.archivo_ayuda'|trans }}</p>
        </div>
        <input type="hidden" name="_token" value="{{ csrf_token('importar-recursos') }}">
        <div class="formulario__acciones">
            <button type="submit" class="boton">{{ 'importacion.revisar'|trans }}</button>
            <a href="{{ path('panel_recursos_plantilla') }}" data-turbo="false">{{ 'importacion.plantilla'|trans }}</a>
        </div>
    </form>

    <h2>{{ 'importacion.bibliografia_titulo'|trans }}</h2>
    <p>{{ 'importacion.bibliografia_texto'|trans }}</p>

    <h2>{{ 'importacion.columnas'|trans }}</h2>
    <p>{{ 'importacion.columnas_ayuda'|trans }}</p>
    <div class="tabla-desplazable">
        <table class="tabla">
            <thead>
                <tr>
                    <th scope="col">{{ 'importacion.campo'|trans }}</th>
                    <th scope="col">{{ 'importacion.detalle'|trans }}</th>
                </tr>
            </thead>
            <tbody>
                {% for campo, aceptados in columnas %}
                    <tr>
                        <th scope="row">{{ ('importacion.columna.' ~ campo)|trans }}</th>
                        <td>{{ ('importacion.columna_ayuda.' ~ campo)|trans }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
