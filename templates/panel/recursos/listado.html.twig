{% extends 'panel/_layout.html.twig' %}

{% block title %}{{ 'panel.recursos'|trans }}{% endblock %}

{% block contenido %}
    <div class="encabezado-accion">
        <h1>{{ 'panel.recursos'|trans }}</h1>
        <div class="encabezado-accion__botones">
            <a class="boton boton--secundario" href="{{ path('panel_recursos_importar') }}">{{ 'importacion.titulo'|trans }}</a>
            <a class="boton" href="{{ path('panel_recurso_nuevo') }}">{{ 'recurso.nuevo'|trans }}</a>
        </div>
    </div>

    <form method="get" class="filtro" role="search">
        <label for="q" class="solo-lectores">{{ 'bases.buscar'|trans }}</label>
        <input type="search" id="q" name="q" value="{{ q }}" placeholder="{{ 'bases.buscar_placeholder'|trans }}" class="filtro__texto">
        <label for="filtro-tipo" class="solo-lectores">{{ 'bases.tipo'|trans }}</label>
        <select id="filtro-tipo" name="tipo">
            <option value="">{{ 'bases.todos_tipos'|trans }}</option>
            {% for t in tipos %}<option value="{{ t.value }}" {% if tipo == t %}selected{% endif %}>{{ t.etiqueta|trans }}</option>{% endfor %}
        </select>
        <label for="filtro-formato" class="solo-lectores">{{ 'formato_recurso.filtro'|trans }}</label>
        <select id="filtro-formato" name="formato">
            <option value="">{{ 'formato_recurso.todos'|trans }}</option>
            {% for f in formatos %}<option value="{{ f.value }}" {% if formato == f %}selected{% endif %}>{{ f.filtro|trans }}</option>{% endfor %}
        </select>
        <label for="filtro-materia" class="solo-lectores">{{ 'bases.materia'|trans }}</label>
        <select id="filtro-materia" name="materia">
            <option value="">{{ 'bases.todas_materias'|trans }}</option>
            {{ include('_opciones_materias.html.twig', {materias: materias, elegida: materia}) }}
        </select>
        {% if app.request.query.get('por_pagina') %}<input type="hidden" name="por_pagina" value="{{ pagina.porPagina }}">{% endif %}
        <button type="submit" class="boton boton--secundario">{{ 'bases.buscar'|trans }}</button>
    </form>
    {{ include('panel/_filtros_recordados.html.twig', {ruta: 'panel_recursos'}) }}

    {% if pagina.total == 0 %}
        <p>{{ 'recurso.vacio'|trans }}</p>
    {% else %}
        {% set filtros = {q: q ?: null, tipo: tipo ? tipo.value : null, formato: formato ? formato.value : null, materia: materia ? materia.slug : null}|filter(v => v is not null) %}
        <div class="exportar-recursos">
            <p>{{ 'bases.resultados'|trans({'%count%': pagina.total}) }}</p>
            <p class="exportar-recursos__enlaces">
                <span>{{ 'exportacion.exportar'|trans({'%count%': pagina.total}) }}</span>
                <a class="boton boton--secundario boton--pequeno" href="{{ path('panel_recursos_exportar', filtros|merge({extension: 'xlsx'})) }}" data-turbo="false" download>{{ icono('descargar') }} {{ 'exportacion.excel'|trans }}</a>
                <a class="boton boton--secundario boton--pequeno" href="{{ path('panel_recursos_exportar', filtros|merge({extension: 'ris'})) }}" data-turbo="false" download>{{ icono('descargar') }} {{ 'exportacion.ris'|trans }}</a>
            </p>
        </div>
        {% include 'paginacion/_cantidad.html.twig' %}
        <div class="tabla-desplazable">
            <table class="tabla">
                <thead>
                    <tr>
                        <th scope="col">{{ 'recurso.titulo'|trans }}</th>
                        <th scope="col">{{ 'recurso.tipo'|trans }}</th>
                        <th scope="col">{{ 'recurso.acceso'|trans }}</th>
                        <th scope="col">{{ 'recurso.proxy_corto'|trans }}</th>
                        <th scope="col">{{ 'recurso.clics'|trans }}</th>
                        <th scope="col"><span class="solo-lectores">{{ 'formulario.acciones'|trans }}</span></th>
                    </tr>
                </thead>
                <tbody>
                    {% for recurso in pagina.elementos %}
                        <tr{% if not recurso.estaDisponible %} class="tabla__inactivo"{% endif %}>
                            <td>
                                {{ recurso.titulo }}
                                {% if not recurso.visible %}<span class="etiqueta">{{ 'recurso.oculto'|trans }}</span>{% elseif not recurso.estaDisponible %}<span class="etiqueta">{{ 'recurso.prueba_vencida'|trans }}</span>{% endif %}
                                <br><small class="tabla__url">{{ recurso.url }}</small>
                            </td>
                            <td>{{ recurso.tipo.etiqueta|trans }}{% if recurso.formato %}<br>{{ include('recursos/_formato.html.twig', {formato: recurso.formato.value}) }}{% endif %}</td>
                            <td>{{ recurso.acceso.etiqueta|trans }}</td>
                            <td>{{ (recurso.requiereProxy ? 'formulario.si' : 'formulario.no')|trans }}</td>
                            <td>{{ recurso.clics }}</td>
                            <td class="tabla__acciones">
                                <a class="accion" data-tooltip="{{ 'formulario.editar'|trans }}" href="{{ path('panel_recurso_editar', {id: recurso.id}) }}">{{ icono('editar') }}<span class="solo-lectores">{{ 'formulario.editar'|trans }} {{ recurso.titulo }}</span></a>
                                {% include 'admin/_eliminar.html.twig' with {ruta: 'panel_recurso_eliminar', id: recurso.id, token: 'eliminar-recurso-' ~ recurso.id, nombre: recurso.titulo} %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% include 'paginacion/_enlaces.html.twig' with {ruta: 'panel_recursos'} %}
    {% endif %}
{% endblock %}
