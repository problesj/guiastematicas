{% extends 'base.html.twig' %}

{% block body %}
    <section class="portada">
        <div class="contenedor">
            <h1>{{ 'inicio.titulo'|trans }}</h1>
            <p class="portada__bajada">{{ 'inicio.bajada'|trans }}</p>
            <form class="buscador" role="search" action="{{ path('bases_datos') }}" method="get">
                <label for="q" class="solo-lectores">{{ 'inicio.buscar_etiqueta'|trans }}</label>
                <input id="q" name="q" type="search" placeholder="{{ 'inicio.buscar_placeholder'|trans }}">
                <button type="submit">{{ 'inicio.buscar'|trans }}</button>
            </form>
        </div>
    </section>

    <section class="contenedor tarjetas" aria-label="{{ 'inicio.secciones'|trans }}">
        <article class="tarjeta">
            <h2>{{ 'menu.guias'|trans }}</h2>
            <p>{{ 'inicio.guias_texto'|trans }}</p>
        </article>
        <article class="tarjeta">
            <h2><a href="{{ path('bases_datos') }}">{{ 'menu.bases_datos'|trans }}</a></h2>
            <p>{{ 'inicio.bases_texto'|trans }}</p>
        </article>
        <article class="tarjeta">
            <h2><a href="{{ path('personal') }}">{{ 'menu.personal'|trans }}</a></h2>
            <p>{{ 'inicio.personal_texto'|trans }}</p>
        </article>
    </section>
{% endblock %}
