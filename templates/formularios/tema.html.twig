{% extends 'form_div_layout.html.twig' %}

{# Cada campo en un bloque .campo, con la ayuda y los errores asociados para lectores de pantalla. #}
{%- block form_row -%}
    {%- set widget_attr = {} -%}
    {%- if help is not empty -%}
        {%- set widget_attr = {attr: {'aria-describedby': id ~ '_help'}} -%}
    {%- endif -%}
    <div class="campo{% if not valid %} campo--error{% endif %}{% if 'checkbox' in block_prefixes %} campo--casilla{% endif %}{% if row_attr.class is defined %} {{ row_attr.class }}{% endif %}">
        {%- if 'checkbox' in block_prefixes -%}
            {{- form_widget(form, widget_attr) -}}
            {{- form_label(form) -}}
        {%- else -%}
            {{- form_label(form) -}}
            {{- form_widget(form, widget_attr) -}}
        {%- endif -%}
        {{- form_help(form) -}}
        {{- form_errors(form) -}}
    </div>
{%- endblock form_row -%}

{%- block form_errors -%}
    {%- if errors|length > 0 -%}
        <ul class="campo__errores" role="alert">
            {%- for error in errors -%}
                <li>{{ error.message }}</li>
            {%- endfor -%}
        </ul>
    {%- endif -%}
{%- endblock form_errors -%}

{%- block form_help -%}
    {%- if help is not empty -%}
        <p id="{{ id }}_help" class="campo__ayuda">{{ help|trans(help_translation_parameters, translation_domain) }}</p>
    {%- endif -%}
{%- endblock form_help -%}

{%- block choice_widget_expanded -%}
    <div {{ block('widget_container_attributes') }} class="casillas">
        {%- for child in form %}
            <label class="casillas__opcion">{{- form_widget(child) -}} {{ choice_translation_domain is same as(false) ? child.vars.label : child.vars.label|trans({}, choice_translation_domain) }}</label>
        {% endfor -%}
    </div>
{%- endblock choice_widget_expanded -%}

{# Categorías ASJC y materias: un desplegable por campo (abierto si tiene marcadas) y un buscador (filtro-asjc).
   En el selector de materias, las propias van tras su categoría (data-propia). #}
{%- block asjc_widget -%}
    <div {{ block('widget_container_attributes') }} class="asjc" data-controller="filtro-asjc" data-filtro-asjc-resultados-value="{{ 'materia.asjc_resultados'|trans }}">
        {%- set buscar = buscar|default('materia.asjc_buscar'|trans) -%}
        <input type="search" class="asjc__buscar" autocomplete="off" placeholder="{{ buscar }}" aria-label="{{ buscar }}" data-action="input->filtro-asjc#filtrar">
        <p class="campo__ayuda" role="status" data-filtro-asjc-target="estado"></p>
        {%- set campo = null -%}
        {%- for child in form -%}
            {%- set actual = child.vars.attr['data-campo'] -%}
            {%- if actual != campo -%}
                {%- if campo is not null %}</div></details>{% endif -%}
                <details class="asjc__campo" data-filtro-asjc-target="campo"{% if marcados[actual] is defined %} open{% endif %}>
                    <summary>{% if actual > 0 %}{{ actual }} · {{ campos[actual] }}{% else %}{{ 'materia.sin_clasificar'|trans }}{% endif %}{% if marcados[actual] is defined %} <span class="asjc__cuenta">({{ marcados[actual] }})</span>{% endif %}</summary>
                    <div class="casillas">
                {%- set campo = actual -%}
            {%- endif -%}
            <label class="casillas__opcion{% if child.vars.attr['data-propia'] is defined %} casillas__opcion--propia{% endif %}">{{- form_widget(child) -}} {{ child.vars.label }}</label>
        {%- endfor -%}
        {%- if campo is not null %}</div></details>{% endif -%}
    </div>
{%- endblock asjc_widget -%}

{%- block materias_asjc_widget -%}
    {%- set buscar = 'materia.selector_buscar'|trans -%}
    {{ block('asjc_widget') }}
{%- endblock materias_asjc_widget -%}

{%- block materias_compactas_widget -%}
    {{ include('_selector_materias.html.twig', {id: id ~ '_buscar', nombre: full_name, marcadas: marcadas}) }}
{%- endblock materias_compactas_widget -%}
