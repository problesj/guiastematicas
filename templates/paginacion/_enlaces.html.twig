{# Enlaces a las páginas. Parámetros: pagina (App\Paginacion\Pagina), ruta y, opcional, parametros de la ruta. Conserva filtros y cantidad por página. #}
{% if pagina.paginas > 1 %}
    {% set consulta = (parametros|default({}))|merge(app.request.query.all|filter((v, k) => k != 'pagina' and v is not iterable)) %}
    <nav class="paginacion" aria-label="{{ 'paginacion.etiqueta'|trans }}">
        <ul>
            <li>
                {% if pagina.numero > 1 %}
                    <a href="{{ path(ruta, consulta|merge({pagina: pagina.numero - 1})) }}" rel="prev">{{ 'paginacion.anterior'|trans }}</a>
                {% else %}
                    <span aria-disabled="true">{{ 'paginacion.anterior'|trans }}</span>
                {% endif %}
            </li>
            {% for n in pagina.enlaces %}
                <li>
                    {% if n is null %}
                        <span aria-hidden="true">…</span>
                    {% elseif n == pagina.numero %}
                        <a href="{{ path(ruta, consulta|merge({pagina: n})) }}" aria-current="page"><span class="solo-lectores">{{ 'paginacion.pagina'|trans }} </span>{{ n }}</a>
                    {% else %}
                        <a href="{{ path(ruta, consulta|merge({pagina: n})) }}"><span class="solo-lectores">{{ 'paginacion.pagina'|trans }} </span>{{ n }}</a>
                    {% endif %}
                </li>
            {% endfor %}
            <li>
                {% if pagina.numero < pagina.paginas %}
                    <a href="{{ path(ruta, consulta|merge({pagina: pagina.numero + 1})) }}" rel="next">{{ 'paginacion.siguiente'|trans }}</a>
                {% else %}
                    <span aria-disabled="true">{{ 'paginacion.siguiente'|trans }}</span>
                {% endif %}
            </li>
        </ul>
    </nav>
{% endif %}
