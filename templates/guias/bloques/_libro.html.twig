{# Un libro del bloque Libros. Con lista: miniatura a la izquierda y todos los datos, con el enlace de acceso visible. #}
{% set lista = lista ?? false %}
{% set destino = libro.enlace ?? null %}
{% if not destino and libro.registro is defined and libro.registro %}{% set destino = enlace_registro_catalogo(libro.registro, guia.idioma) %}{% endif %}
{% if not destino and libro.doi is defined and libro.doi %}{% set destino = 'https://doi.org/' ~ libro.doi %}{% endif %}
{% if not destino and hay_buscador_primo() %}{% set destino = path('catalogo', {_locale: guia.idioma, q: libro.isbn ?? libro.titulo}) %}{% endif %}
{% set edicion = [libro.editorial ?? null, libro.anio ?? null]|filter(v => v)|join(', ') %}
<li class="libro{{ lista ? ' libro--lista' }}">
    {% if destino %}<a class="libro__enlace" href="{{ destino }}" target="_blank" rel="noopener"{% if lista %} tabindex="-1" aria-hidden="true"{% endif %}>{% else %}<span class="libro__enlace">{% endif %}
        <span class="libro__portada" aria-hidden="true">
            <span class="libro__sin-portada">{{ lista ? '' : libro.titulo }}</span>
            {% if libro.isbn %}<img src="https://covers.openlibrary.org/b/isbn/{{ libro.isbn|url_encode }}-M.jpg?default=false" alt="" data-controller="portada" data-action="load->portada#revisar error->portada#revisar" width="120" height="180" loading="lazy" referrerpolicy="no-referrer">{% endif %}
        </span>
        {% if not lista %}
            <span class="libro__titulo">{{ libro.titulo }}</span>
            {% if destino %}<span class="solo-lectores"> ({{ 'bases.ventana_nueva'|trans }})</span>{% endif %}
        {% endif %}
    {% if destino %}</a>{% else %}</span>{% endif %}
    {% if lista %}
        <div class="libro__datos">
            <span class="libro__titulo">{% if destino %}<a href="{{ destino }}" target="_blank" rel="noopener">{{ libro.titulo }}<span class="solo-lectores"> ({{ 'bases.ventana_nueva'|trans }})</span></a>{% else %}{{ libro.titulo }}{% endif %}</span>
            {% if libro.autor %}<span class="libro__autor">{{ libro.autor }}</span>{% endif %}
            {% if edicion %}<span class="libro__edicion">{{ edicion }}</span>{% endif %}
            {% if destino %}<span class="libro__acceso"><a href="{{ destino }}" target="_blank" rel="noopener">{{ (libro.enlace ?? null) ? 'bloque.libro_acceso'|trans : ((libro.registro ?? null) ? 'bloque.libro_ver_catalogo'|trans : ((libro.doi ?? null) ? 'DOI: ' ~ libro.doi : 'bloque.libro_buscar_catalogo'|trans)) }}<span class="solo-lectores"> {{ libro.titulo }} ({{ 'bases.ventana_nueva'|trans }})</span></a></span>{% endif %}
            {% if libro.mms ?? false %}<span class="libro__disponibilidad" data-disponibilidad-target="libro" data-mms="{{ libro.mms }}" role="status"></span>{% endif %}
        </div>
    {% else %}
        {% if libro.autor %}<span class="libro__autor">{{ libro.autor }}</span>{% endif %}
        {% if edicion %}<span class="libro__edicion">{{ edicion }}</span>{% endif %}
        {% if libro.mms ?? false %}<span class="libro__disponibilidad" data-disponibilidad-target="libro" data-mms="{{ libro.mms }}" role="status"></span>{% endif %}
    {% endif %}
</li>
