{# Una revista del bloque Revistas (variable "libro", como en _libros.html.twig). Sin portada: se muestra el título
   sobre el color del sitio. El enlace va al propio de la revista, a su registro en el catálogo o a una búsqueda. #}
{% set lista = lista ?? false %}
{% set destino = libro.enlace ?? null %}
{% if not destino and (libro.registro ?? null) %}{% set destino = enlace_registro_catalogo(libro.registro, guia.idioma) %}{% endif %}
{% if not destino and hay_buscador_primo() %}{% set destino = path('catalogo', {_locale: guia.idioma, q: (libro.issn ?? null) ?: libro.titulo}) %}{% endif %}
{% set issns = [(libro.issn ?? null) ? 'ISSN ' ~ libro.issn : null, (libro.eissn ?? null) ? 'e-ISSN ' ~ libro.eissn : null]|filter(v => v)|join(' · ') %}
<li class="libro libro--revista{{ lista ? ' libro--lista' }}">
    {% if destino %}<a class="libro__enlace" href="{{ destino }}" target="_blank" rel="noopener"{% if lista %} tabindex="-1" aria-hidden="true"{% endif %}>{% else %}<span class="libro__enlace">{% endif %}
        <span class="libro__portada" aria-hidden="true">
            <span class="libro__sin-portada">{{ lista ? '' : libro.titulo }}</span>
        </span>
        {% if not lista %}
            <span class="libro__titulo">{{ libro.titulo }}</span>
            {% if destino %}<span class="solo-lectores"> ({{ 'bases.ventana_nueva'|trans }})</span>{% endif %}
        {% endif %}
    {% if destino %}</a>{% else %}</span>{% endif %}
    {% if lista %}
        <div class="libro__datos">
            <span class="libro__titulo">{% if destino %}<a href="{{ destino }}" target="_blank" rel="noopener">{{ libro.titulo }}<span class="solo-lectores"> ({{ 'bases.ventana_nueva'|trans }})</span></a>{% else %}{{ libro.titulo }}{% endif %}</span>
            {% if libro.editorial ?? null %}<span class="libro__autor">{{ libro.editorial }}</span>{% endif %}
            {% if issns %}<span class="libro__edicion">{{ issns }}</span>{% endif %}
            {% if destino %}<span class="libro__acceso"><a href="{{ destino }}" target="_blank" rel="noopener">{{ (libro.enlace ?? null) ? 'bloque.revista_acceso'|trans : ((libro.registro ?? null) ? 'bloque.libro_ver_catalogo'|trans : 'bloque.libro_buscar_catalogo'|trans) }}<span class="solo-lectores"> {{ libro.titulo }} ({{ 'bases.ventana_nueva'|trans }})</span></a></span>{% endif %}
        </div>
    {% else %}
        {% if libro.editorial ?? null %}<span class="libro__autor">{{ libro.editorial }}</span>{% endif %}
        {% if issns %}<span class="libro__edicion">{{ issns }}</span>{% endif %}
    {% endif %}
</li>
