{# Libros con portada de Open Library (por ISBN). El enlace va al registro del catálogo (Primo VE) si se encontró por
   ISBN; si no, a una búsqueda en el catálogo, salvo que el libro tenga un enlace propio. La disponibilidad (Alma) se
   pide después de cargar la página. #}
{% set items = bloque.dato('items', []) %}
{% if items is not empty %}
    {% set disponibilidad = catalogo_informa_disponibilidad() and items|filter(l => l.mms ?? false) is not empty %}
    <ul class="bloque__libros"{% if disponibilidad %} data-controller="disponibilidad" data-disponibilidad-url-value="{{ path('catalogo_disponibilidad', {_locale: guia.idioma, id: bloque.id}) }}"{% endif %}>
        {% for libro in items %}
            {% set destino = libro.enlace ?? null %}
            {% if not destino and libro.registro is defined and libro.registro %}{% set destino = enlace_registro_catalogo(libro.registro, guia.idioma) %}{% endif %}
            {% if not destino and hay_buscador_primo() %}{% set destino = path('catalogo', {_locale: guia.idioma, q: libro.isbn ?? libro.titulo}) %}{% endif %}
            <li class="libro">
                {% if destino %}<a class="libro__enlace" href="{{ destino }}" target="_blank" rel="noopener">{% else %}<span class="libro__enlace">{% endif %}
                    <span class="libro__portada" aria-hidden="true">
                        <span class="libro__sin-portada">{{ libro.titulo }}</span>
                        {% if libro.isbn %}<img src="https://covers.openlibrary.org/b/isbn/{{ libro.isbn|url_encode }}-M.jpg?default=false" alt="" data-controller="portada" data-action="load->portada#revisar error->portada#revisar" width="120" height="180" loading="lazy" referrerpolicy="no-referrer">{% endif %}
                    </span>
                    <span class="libro__titulo">{{ libro.titulo }}</span>
                    {% if destino %}<span class="solo-lectores"> ({{ 'bases.ventana_nueva'|trans }})</span>{% endif %}
                {% if destino %}</a>{% else %}</span>{% endif %}
                {% if libro.autor %}<span class="libro__autor">{{ libro.autor }}</span>{% endif %}
                {% if libro.editorial ?? false or libro.anio ?? false %}<span class="libro__edicion">{{ [libro.editorial ?? null, libro.anio ?? null]|filter(v => v)|join(', ') }}</span>{% endif %}
                {% if disponibilidad and libro.mms ?? false %}<span class="libro__disponibilidad" data-disponibilidad-target="libro" data-mms="{{ libro.mms }}" role="status"></span>{% endif %}
            </li>
        {% endfor %}
    </ul>
{% endif %}
